<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>SPTDevSuite.Server</AssemblyName>
    <RootNamespace>SPTDevSuite.Server</RootNamespace>
    <OutputType>Library</OutputType>
    <Version>0.2.0</Version>
    <PackageDirectory>$(MSBuildProjectDirectory)\..\..\Build\SPTDevSuite</PackageDirectory>
  </PropertyGroup>

  <ItemGroup Condition="'$(SptServerAssemblyRoot)' == ''">
    <ProjectReference Include="..\SPTDevSuite.Contracts\SPTDevSuite.Contracts.csproj" />
    <PackageReference Include="SPTushonka.Common" Version="4.1.3" />
    <PackageReference Include="SPTushonka.DI" Version="4.1.3" />
    <PackageReference Include="SPTushonka.Server.Core" Version="4.1.3" />
  </ItemGroup>

  <ItemGroup Condition="'$(SptServerAssemblyRoot)' != ''">
    <ProjectReference Include="..\SPTDevSuite.Contracts\SPTDevSuite.Contracts.csproj" />
    <Reference Include="SemanticVersioning" HintPath="$(SptServerAssemblyRoot)\SemanticVersioning.dll" Private="true" />
    <Reference Include="SPTarkov.Common" HintPath="$(SptServerAssemblyRoot)\SPTarkov.Common.dll" Private="true" />
    <Reference Include="SPTarkov.DI" HintPath="$(SptServerAssemblyRoot)\SPTarkov.DI.dll" Private="true" />
    <Reference Include="SPTarkov.Server.Core" HintPath="$(SptServerAssemblyRoot)\SPTarkov.Server.Core.dll" Private="true" />
  </ItemGroup>

  <Target Name="ValidateLocalSptServerAssemblies" BeforeTargets="ResolveReferences" Condition="'$(SptServerAssemblyRoot)' != ''">
    <Error Condition="!Exists('$(SptServerAssemblyRoot)\SemanticVersioning.dll')" Text="Missing final server dependency: $(SptServerAssemblyRoot)\SemanticVersioning.dll" />
    <Error Condition="!Exists('$(SptServerAssemblyRoot)\SPTarkov.Common.dll')" Text="Missing final server assembly: $(SptServerAssemblyRoot)\SPTarkov.Common.dll" />
    <Error Condition="!Exists('$(SptServerAssemblyRoot)\SPTarkov.DI.dll')" Text="Missing final server assembly: $(SptServerAssemblyRoot)\SPTarkov.DI.dll" />
    <Error Condition="!Exists('$(SptServerAssemblyRoot)\SPTarkov.Server.Core.dll')" Text="Missing final server assembly: $(SptServerAssemblyRoot)\SPTarkov.Server.Core.dll" />
    <ItemGroup>
      <_LocalSptAssembly Include="$(SptServerAssemblyRoot)\SPTarkov.Common.dll" ExpectedVersion="4.1.3.0" />
      <_LocalSptAssembly Include="$(SptServerAssemblyRoot)\SPTarkov.DI.dll" ExpectedVersion="4.1.3.0" />
      <_LocalSptAssembly Include="$(SptServerAssemblyRoot)\SPTarkov.Server.Core.dll" ExpectedVersion="4.1.3.0" />
      <_LocalSptAssembly Include="$(SptServerAssemblyRoot)\SemanticVersioning.dll" ExpectedVersion="3.0.0.0" />
    </ItemGroup>
    <GetAssemblyIdentity AssemblyFiles="@(_LocalSptAssembly)">
      <Output TaskParameter="Assemblies" ItemName="_LocalSptAssemblyIdentity" />
    </GetAssemblyIdentity>
    <Error
      Condition="'%(_LocalSptAssemblyIdentity.Version)' != '%(_LocalSptAssemblyIdentity.ExpectedVersion)'"
      Text="Unexpected local server assembly identity: %(_LocalSptAssemblyIdentity.Filename) is %(_LocalSptAssemblyIdentity.Version), expected %(_LocalSptAssemblyIdentity.ExpectedVersion)."
    />
  </Target>

  <Target Name="AssembleInstallPackage" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <RemoveDir Directories="$(PackageDirectory)" />
    <MakeDir Directories="$(PackageDirectory)" />
    <Copy SourceFiles="$(TargetPath);$(TargetDir)SPTDevSuite.Contracts.dll" DestinationFolder="$(PackageDirectory)" />
  </Target>
</Project>
